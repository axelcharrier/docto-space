# Production environment for /srv/docker/doctospace/.env  (chmod 600)
# Read by both the `app` and `migrate` services in compose.yaml.
# Copy to .env and fill in every value — none of these are optional.

# ---- Auth.js ----
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=
AUTH_URL=https://doctospace.leodautriche.fr
AUTH_TRUST_HOST=true

# ---- Authentik OIDC (application type: Confidential) ----
# Redirect URI to register in Authentik:
#   https://doctospace.leodautriche.fr/api/auth/callback/authentik
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Provider issuer URL including the app slug, WITH trailing slash
# (Auth.js compares it to the value in Authentik's discovery document).
AUTHENTIK_ISSUER=https://authentik.leodautriche.fr/application/o/docto-space/

# ---- MariaDB (Prisma) ----
# The migrate container runs `prisma migrate deploy` with this user, so it
# needs CREATE/ALTER/DROP rights on the database, not just DML.
# Host: the MariaDB service name if it's in the same compose network,
# or host.docker.internal / the VPS IP if MariaDB runs on the host.
DATABASE_URL=mysql://doctospace:CHANGE_ME@mariadb:3306/doctospace

# ---- Visio (La Suite Numérique) — external API used to create meeting rooms ----
VISIO_API_URL=
VISIO_CLIENT_ID=
VISIO_CLIENT_SECRET=

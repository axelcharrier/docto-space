datasource db {
  provider = "mysql" // compatible MariaDB
}

generator client {
  provider = "prisma-client-js"
}

// --- Modèles canoniques Auth.js (ne pas renommer les champs) ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(ASTRONAUTE)
  specialite    String?   // renseigné uniquement si role = MEDECIN
  // UID de la carte NFC lue par le distributeur (ESP32), en hexadécimal
  // majuscule sans séparateur. Astronautes uniquement, renseigné à la main
  // pour le prototype.
  rfidUid       String?   @unique

  accounts      Account[]
  sessions      Session[]

  demandesEnvoyees  DemandeConsultation[] @relation("DemandesAstronaute")
  demandesRecues    DemandeConsultation[] @relation("DemandesMedecin")
  prescriptionsRecues   Prescription[] @relation("PrescriptionsAstronaute")
  prescriptionsEmises   Prescription[] @relation("PrescriptionsMedecin")
  notifications     Notification[]
}

enum Role {
  ASTRONAUTE
  MEDECIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Métier ---
model DemandeConsultation {
  id               String   @id @default(uuid())
  astronaute       User     @relation("DemandesAstronaute", fields: [astronauteId], references: [id])
  astronauteId     String
  // null tant qu'aucun médecin n'a traité la demande
  medecin          User?    @relation("DemandesMedecin", fields: [medecinId], references: [id])
  medecinId        String?
  dateSouhaitee    DateTime
  dateConsultation DateTime?
  commentaire      String   @db.Text
  statut           StatutDemande @default(EN_ATTENTE)
  motifRefus       String?  @db.Text
  lienVisio        String?
  visioRoomId      String?
  prescriptions    Prescription[]
  notifications    Notification[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([statut])
}

enum StatutDemande {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      TypeNotification
  titre     String
  message   String   @db.Text
  lienUrl   String?
  lue       Boolean  @default(false)
  demande   DemandeConsultation? @relation(fields: [demandeId], references: [id], onDelete: SetNull)
  demandeId String?
  createdAt DateTime @default(now())

  @@index([userId, lue])
  @@index([userId, createdAt])
}

enum TypeNotification {
  NOUVELLE_DEMANDE
  DEMANDE_ACCEPTEE
  DEMANDE_REFUSEE
  NOUVELLE_PRESCRIPTION
  PRESCRIPTION_MODIFIEE
  PRESCRIPTION_SUPPRIMEE
}

model Prescription {
  id               String   @id @default(uuid())
  // L'astronaute est porté par la prescription elle-même, pas déduit de la
  // demande : c'est ce qui permet de prescrire hors consultation, et c'est
  // le seul filtre d'isolation entre astronautes (lib/data/prescriptions.ts).
  astronaute       User     @relation("PrescriptionsAstronaute", fields: [astronauteId], references: [id])
  astronauteId     String
  medecin          User     @relation("PrescriptionsMedecin", fields: [medecinId], references: [id])
  medecinId        String
  // null quand le médecin prescrit sans passer par un rendez-vous
  demande          DemandeConsultation? @relation(fields: [demandeId], references: [id], onDelete: SetNull)
  demandeId        String?
  // consigne générale, en complément de la posologie de chaque ligne
  commentaire      String?  @db.Text
  datePrescription DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lignes           LignePrescription[]
  prises           PrisePlanifiee[]

  @@index([astronauteId])
  @@index([medecinId])
}

// Référentiel officiel des médicaments (base publique des médicaments,
// ANSM/data.gouv). Alimenté par prisma/seed.ts depuis
// prisma/data/medicaments-bdpm.tsv : jamais écrit par l'application, le
// médecin ne peut que choisir dedans — d'où l'impossibilité de se tromper
// dans l'orthographe.
model Medicament {
  // Code CIS : identifiant officiel de la spécialité, sert de clé primaire
  // pour que le référentiel puisse être ré-importé sans casser les liens.
  codeCis             String   @id
  // "DOLIPRANE 500 mg, comprimé" — le dosage fait partie du nom officiel.
  denomination        String
  formePharmaceutique String
  lignes              LignePrescription[]
  prises              PrisePlanifiee[]

  @@index([denomination])
}

model LignePrescription {
  id             String   @id @default(uuid())
  // Cascade : modifier une prescription remplace ses lignes, la supprimer
  // les emporte.
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescriptionId String
  medicament     Medicament @relation(fields: [medicamentId], references: [codeCis])
  medicamentId   String
  // Quantité par prise ("1 comprimé", "2 gouttes") : le dosage de la
  // spécialité est déjà dans `medicament.denomination`.
  quantite       String?
  // Texte lisible généré à l'enregistrement (formatPosologie), affiché tel
  // quel à l'astronaute.
  posologie        String
  // Champs structurés d'origine, conservés pour pouvoir ré-éditer la ligne
  // sans avoir à re-parser `posologie`.
  moments          String?  @db.Text
  intervalleHeures Int?
  dureeJours       Int?
  instructions     String?

  @@index([prescriptionId])
}

// Prise distribuée par le distributeur (lib/data/distributeur.ts).
// Rattachée à la prescription et au médicament plutôt qu'à la ligne :
// modifier une prescription recrée ses lignes, et l'historique du jour
// doit survivre sinon le distributeur redonnerait la même dose.
model PrisePlanifiee {
  id              String   @id @default(uuid())
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescriptionId  String
  medicament      Medicament @relation(fields: [medicamentId], references: [codeCis])
  medicamentId    String
  // Début du créneau pour une prise à un moment de la journée, instant du
  // scan pour une prise à intervalle.
  dateHeurePrevue DateTime
  datePrise       DateTime?
  statut          StatutPrise @default(A_VENIR)

  // Un créneau ne peut être distribué qu'une fois.
  @@unique([prescriptionId, medicamentId, dateHeurePrevue])
}

enum StatutPrise {
  A_VENIR
  PRISE
  MANQUEE
}
